# Per-collection share/preview pages: /c/<txid> → share.php (server-rendered Open Graph for link crawlers).
# Everything else (the SPA at /, bundle.js, /brand, /og/*.jpg …) is served normally as static files.
RewriteEngine On
RewriteRule ^c/([0-9a-fA-F]{64})/?$ share.php?c=$1 [L,QSA]
# Shortened share links: /s/<code> → share.php resolves the code to {txid, holder, aff} (public only).
RewriteRule ^s/([0-9A-Za-z]{1,16})/?$ share.php?s=$1 [L,QSA]

# Don't expose directory listings (e.g. of the /og cache). Its files are only public cover JPEGs +
# title/description JSON, so direct access is harmless — just no browsable index.
Options -Indexes

# ── Cache policy: never let a returning visitor run a STALE app ────────────────────────────────────
# index.html + bundle.js have fixed names, so without this a browser can keep a week-old bundle from disk
# cache and never recheck — an outdated client against newer on-chain formats can break features (e.g.
# "View content" on a fresh acquisition). Force the SPA shell + bundle to revalidate every load; ETag/304
# makes that near-free when nothing changed, and guarantees a fresh copy the moment a new build ships.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Content-addressed / rarely-changing assets can cache hard (covers/brand art are effectively immutable).
  <FilesMatch "\.(woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
